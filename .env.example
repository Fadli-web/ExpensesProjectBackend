# Supabase Configuration
# Ambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Vision OCR - Google Gemini (used by /api/receipts/scan)
# Ambil dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Storage bucket names (create these in Supabase Storage)
AVATAR_BUCKET=avatars
RECEIPT_BUCKET=receipts

# Optional CORS origin (contoh: http://localhost:5173 atau https://myapp.vercel.app)
CORS_ORIGIN=*
