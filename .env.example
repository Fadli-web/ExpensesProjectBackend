# 1. MongoDB Connection String (Ambil dari cloud.mongodb.com > Connect > Drivers)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/expense_tracker?retryWrites=true&w=majority

# 2. Kunci rahasia untuk tanda tangan token JWT (bebas dibuat sendiri)
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# 3. Google Gemini API Key untuk fitur AI Receipt Scanner (Ambil dari aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 4. Domain Frontend yang boleh mengakses backend ini (Gunakan * saat development)
CORS_ORIGIN=*
