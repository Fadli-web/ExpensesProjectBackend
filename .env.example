# Ambil dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Ambil dari aistudio.google.com > Get API key (untuk fitur AI Receipt Scanner Gemini 1.5 Flash)
GEMINI_API_KEY=AIzaSy...

# Domain frontend yang boleh mengakses API ini (untuk CORS). Gunakan "*" saat development.
CORS_ORIGIN=https://your-frontend-domain.com

# Secret bebas (string acak panjang) untuk melindungi endpoint /api/keep-alive
# dari GitHub Actions cron job. Generate contoh: openssl rand -hex 32
KEEP_ALIVE_SECRET=ganti-dengan-string-acak-yang-panjang
