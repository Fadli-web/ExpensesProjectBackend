# ================================================================
# WAJIB: MongoDB Atlas Connection String
# Ambil dari: MongoDB Atlas > Cluster > Connect > Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/nama_database
# ================================================================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/expense_tracker?retryWrites=true&w=majority

# ================================================================
# WAJIB: Kunci rahasia untuk JWT (buat string acak panjang)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ================================================================
# Google Gemini API Key (untuk fitur AI Receipt Scanner)
# Ambil dari: aistudio.google.com > Get API key
# ================================================================
GEMINI_API_KEY=your-gemini-api-key

# ================================================================
# CORS Origin: Domain frontend yang boleh akses API ini
# Gunakan "*" saat development, atau domain spesifik saat production
# Contoh: https://my-frontend.vercel.app
# ================================================================
CORS_ORIGIN=*

# ================================================================
# Keep-Alive Secret: String acak untuk proteksi endpoint /api/keep-alive
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ================================================================
KEEP_ALIVE_SECRET=your-random-keep-alive-secret
