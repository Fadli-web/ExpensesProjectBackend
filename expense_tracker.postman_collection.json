{
  "info": {
    "_postman_id": "e4d7b2c9-9a1b-4f5c-8d3e-7a6b5c4d3e2f",
    "name": "Expense Tracker API (Native MongoDB & JWT)",
    "description": "Koleksi Postman Backend Expense Tracker dengan Native JWT Auth, Manajemen Profil Pengguna (Edit Nama, Ganti Password, Upload Avatar), AI Receipt Scanner Gemini, Dashboard Analitik, dan Ekspor CSV.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://expenses-note-backend.vercel.app",
      "type": "string",
      "description": "URL backend server (gunakan https://expenses-note-backend.vercel.app atau http://localhost:3000)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer Token (otomatis terisi setelah request Register atau Login)"
    },
    {
      "key": "transaction_id",
      "value": "",
      "type": "string",
      "description": "ID Transaksi aktif (otomatis terisi saat membuat transaksi baru)"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autentikasi (Native Auth)",
      "description": "Endpoint registrasi dan login native (bebas dari Supabase) dengan password hashing bcrypt dan token JWT.",
      "item": [
        {
          "name": "Register User Baru",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohammad Fadli\",\n  \"email\": \"fadli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan user baru dengan nama, email, dan password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.collectionVariables.set('token', res.token);",
                  "        console.log('Token JWT otomatis tersimpan ke {{token}}!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login / Masuk",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fadli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login dengan email & password. Script otomatis menyimpan JWT token ke variabel {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.collectionVariables.set('token', res.token);",
                  "        console.log('Token JWT otomatis tersimpan ke {{token}}!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Profil Pengguna (User Profile)",
      "description": "Fitur baru untuk melihat profil, mengedit nama, mengubah password, dan mengunggah foto profil (avatar).",
      "item": [
        {
          "name": "Lihat Profil Saya",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Mengambil data profil pengguna yang sedang login (ID, nama, email, avatar, tanggal dibuat)."
          }
        },
        {
          "name": "Edit Nama Profil",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohammad Fadli - Update\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Mengubah nama pengguna."
          }
        },
        {
          "name": "Ganti Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/user/password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "password"
              ]
            },
            "description": "Mengganti password akun dengan memvalidasi password lama terlebih dahulu."
          }
        },
        {
          "name": "Upload Foto Profil (Avatar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/user/avatar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "avatar"
              ]
            },
            "description": "Mengunggah foto profil (Base64 data URL). Foto akan tersimpan permanen di profil user."
          }
        }
      ]
    },
    {
      "name": "3. Transaksi (Transactions)",
      "description": "CRUD Transaksi Keuangan mandiri dengan MongoDB.",
      "item": [
        {
          "name": "Daftar Transaksi (Filter & Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions?page=1&page_size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Nomor halaman"
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "description": "Jumlah per halaman"
                },
                {
                  "key": "from",
                  "value": "2026-09-01",
                  "description": "Tanggal mulai (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-09-30",
                  "description": "Tanggal akhir (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "Makanan & Minuman",
                  "description": "Filter kategori",
                  "disabled": true
                },
                {
                  "key": "payment_method",
                  "value": "QRIS",
                  "description": "Filter metode bayar",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "Kopi",
                  "description": "Pencarian nama merchant",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Tambah Transaksi Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant\": \"Indomaret Point\",\n  \"amount\": 45000,\n  \"category\": \"Belanja Harian\",\n  \"transaction_date\": \"2026-09-05\",\n  \"payment_method\": \"QRIS\",\n  \"notes\": \"Beli camilan dan kopi botol\",\n  \"items\": [\n    \"Kopi Kenangan Kaleng\",\n    \"Roti Cokelat\",\n    \"Air Mineral 600ml\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/transactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.id) {",
                  "        pm.collectionVariables.set('transaction_id', res.data.id);",
                  "        console.log('ID transaksi tersimpan ke {{transaction_id}}!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Detail Transaksi by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Transaksi",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 48000,\n  \"notes\": \"Ada tambahan permen mint\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Hapus Transaksi",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}"
                }
              ]
            }
          }
        }
      ]
    },
