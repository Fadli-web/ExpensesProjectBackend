    {
      "name": "0. Supabase Auth (Helper)",
      "description": "Endpoint pembantu langsung ke Supabase Auth untuk mendaftar akun dan login guna mendapatkan token Bearer JWT secara otomatis.",
      "item": [
        {
          "name": "Register User Baru (via Backend)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faddli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Daftar user baru langsung lewat endpoint backend /api/auth/register."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('supabase_token', data.access_token);",
                  "        console.log('Token otomatis tersimpan!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login / Sign In (via Backend)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faddli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login langsung ke backend /api/auth/login. Script test otomatis menyimpan access_token ke variable {{supabase_token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('supabase_token', data.access_token);",
                  "        console.log('Access token berhasil disimpan ke variable supabase_token!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register User Baru (Direct ke Supabase)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faddli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/signup",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "signup"
              ]
            },
            "description": "Register langsung ke API Supabase Auth."
          }
        },
        {
          "name": "Login / Sign In (Direct ke Supabase)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faddli@gmail.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Login langsung ke API Supabase Auth."
          }
        }
      ]
    },
    {
      "name": "1. Transaksi (Transactions)",
      "description": "Manajemen pencatatan keuangan (CRUD transaksi) yang terisolasi per-user via Row Level Security (RLS).",
      "item": [
        {
          "name": "List Transaksi (Filter & Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions?page=1&page_size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Nomor halaman (default: 1)"
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "description": "Jumlah baris per halaman (maks 100, default: 20)"
                },
                {
                  "key": "from",
                  "value": "2026-09-01",
                  "description": "Filter tanggal mulai (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-09-30",
                  "description": "Filter tanggal akhir (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "Belanja Harian",
                  "description": "Filter berdasarkan kategori (Makanan & Minuman, Belanja Harian, Transportasi, Kesehatan, Hiburan, Tagihan, Lainnya)",
                  "disabled": true
                },
                {
                  "key": "payment_method",
                  "value": "QRIS",
                  "description": "Filter metode pembayaran (QRIS, Tunai, Transfer, Kartu Debit, Kartu Kredit)",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "Indomaret",
                  "description": "Pencarian merchant (case-insensitive substring)",
                  "disabled": true
                }
              ]
            },
            "description": "Mengambil daftar riwayat transaksi pengguna dengan filter tanggal, kategori, metode bayar, nama toko, dan paginasi."
          }
        },
        {
          "name": "Tambah Transaksi Baru (Create)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant\": \"Indomaret Point\",\n  \"amount\": 48500,\n  \"category\": \"Belanja Harian\",\n  \"transaction_date\": \"2026-09-05\",\n  \"payment_method\": \"QRIS\",\n  \"notes\": \"Beli kopi kaleng dan cemilan roti\",\n  \"items\": [\n    \"Kopi Kenangan Kaleng 220ml\",\n    \"Roti Cokelat Keju\",\n    \"Air Mineral 600ml\"\n  ],\n  \"receipt_path\": \"{{receipt_path}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/transactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "Menambahkan catatan transaksi baru. Field 'merchant' dan 'amount' wajib diisi. Field 'receipt_path' bersifat opsional (diisi dari path hasil upload struk)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.id) {",
                  "        pm.collectionVariables.set('transaction_id', res.data.id);",
                  "        console.log('ID transaksi berhasil disimpan ke {{transaction_id}}: ' + res.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Detail Transaksi by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}",
                  "description": "UUID dari transaksi"
                }
              ]
            },
            "description": "Mengambil data detail satu transaksi berdasarkan UUID."
          }
        },
        {
          "name": "Update Transaksi (PUT / PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant\": \"Indomaret Point - Revisi\",\n  \"amount\": 52000,\n  \"category\": \"Belanja Harian\",\n  \"notes\": \"Ditambah pembelian permen mint\",\n  \"items\": [\n    \"Kopi Kenangan Kaleng 220ml\",\n    \"Roti Cokelat Keju\",\n    \"Air Mineral 600ml\",\n    \"Permen Mint\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}",
                  "description": "UUID dari transaksi"
                }
              ]
            },
            "description": "Memperbarui field tertentu dari sebuah transaksi (hanya field yang dikirim yang akan diupdate)."
          }
        },
        {
          "name": "Hapus Transaksi (DELETE)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/transactions/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{transaction_id}}",
                  "description": "UUID dari transaksi"
                }
              ]
            },
            "description": "Menghapus transaksi. Jika ada foto struk terkait di Supabase Storage, backend otomatis menghapus file foto tersebut."
          }
        }
      ]
    },
    {
      "name": "2. Struk & OCR (Receipts)",
      "description": "Fitur AI Receipt Scanner dengan Google Gemini Vision dan upload file struk ke Supabase Storage privat.",
      "item": [
        {
          "name": "Scan Struk AI (Gemini 1.5 Flash)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"media_type\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/receipts/scan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "receipts",
                "scan"
              ]
            },
            "description": "Kirim gambar struk dalam format Base64 (ukuran disarankan sudah dikompres < 300KB). AI Gemini akan mem-parsing nama merchant, total harga, kategori, tanggal, daftar item, dan metode bayar. Catatan: Endpoint ini TIDAK menyimpan data ke database, hanya untuk auto-fill form."
          }
        },
        {
          "name": "Upload Foto Struk ke Storage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"media_type\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/receipts/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "receipts",
                "upload"
              ]
            },
            "description": "Menyimpan gambar struk ke bucket privat Supabase 'receipts/{user_id}/...'. Mengembalikan path dan signed_url sementara untuk preview."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.path) {",
                  "        pm.collectionVariables.set('receipt_path', res.data.path);",
                  "        console.log('Path struk tersimpan ke {{receipt_path}}: ' + res.data.path);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Generate Signed URL Struk (5 Menit)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/receipts/signed-url?path={{receipt_path}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "receipts",
                "signed-url"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "{{receipt_path}}",
                  "description": "Path struk di bucket privat (misal: user_id/filename.jpg)"
                }
              ]
            },
            "description": "Mendapatkan signed URL baru yang valid selama 5 menit (300 detik) untuk menampilkan gambar struk di galeri atau lightbox."
          }
        }
      ]
    },
