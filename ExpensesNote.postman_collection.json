        },
        {
          "name": "Export CSV - Rentang Tanggal Kustom",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/export/csv?period=custom&start=2026-08-01&end=2026-08-31",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "export", "csv"],
              "query": [
                { "key": "period", "value": "custom" },
                { "key": "start", "value": "2026-08-01", "description": "Format: YYYY-MM-DD" },
                { "key": "end", "value": "2026-08-31", "description": "Format: YYYY-MM-DD" }
              ]
            },
            "description": "Unduh transaksi dalam rentang tanggal kustom. Wajib isi `start` dan `end` saat `period=custom`."
          },
          "response": []
        }
      ]
    }
  ]
}
